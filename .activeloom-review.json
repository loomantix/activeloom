{
  "schema_version": 1,
  "fallback_gate": "fast",
  "gates": {
    "baseline": {
      "always": true,
      "commands": [
        { "argv": ["python3", "-m", "mypy"] },
        { "argv": ["ruff", "check", "."] },
        { "argv": ["npx", "--yes", "prettier@3.8.3", "--check", "."] },
        { "argv": ["python3", ".claude/lint-skill-content.py", "--self-test"] },
        { "argv": ["python3", ".claude/lint-skill-content.py"] },
        { "argv": ["python3", "scripts/run-tests.py", "fast"] }
      ]
    },
    "fast": {
      "commands": [{ "argv": ["python3", "scripts/run-tests.py", "fast"] }]
    },
    "prompts": {
      "paths": [
        "scripts/render-prompts.py",
        "scripts/lint-prompt-parity.py",
        "scripts/create-signed-commit.py",
        "PROMPT_STACK_VERSION",
        ".claude/prompt-stack.json",
        ".codex/prompt-stack.json",
        "prompts/**",
        "tests/test_render_prompts.py",
        "tests/test_prompt_parity_lint.py",
        "tests/test_prompt_stack_hash.py",
        "tests/test_create_signed_commit.py",
        "tests/fixtures/**"
      ],
      "commands": [
        { "argv": ["python3", "scripts/render-prompts.py", "--check"] },
        { "argv": ["python3", "scripts/lint-prompt-parity.py"] }
      ]
    },
    "cli": {
      "paths": ["cli/**", "tests/cli/**", "tests/test_cli_init_equivalence.py"],
      "commands": [
        {
          "argv": [
            "node",
            "--test",
            "tests/cli/cli.test.js",
            "tests/cli/harness-table.test.js",
            "tests/cli/onboard-profiles.test.js",
            "tests/cli/package-smoke.test.js",
            "tests/cli/review-config.test.js",
            "tests/cli/tiers-docs.test.js",
            "tests/cli/workflow-templates.test.js"
          ]
        }
      ]
    },
    "packages_review_ledger": {
      "paths": ["packages/review-ledger/**"],
      "commands": [
        { "argv": ["pnpm", "--dir", "packages/review-ledger", "test"] },
        { "argv": ["pnpm", "--dir", "packages/review-ledger", "build"] }
      ]
    },
    "skills": {
      "paths": [
        ".agents/skills/**",
        ".claude/skills/**",
        ".codex/skills/**",
        "tests/review-accessibility-asset.test.js"
      ],
      "commands": [
        { "argv": ["node", "tests/review-accessibility-asset.test.js"] }
      ]
    },
    "config": {
      "paths": [
        ".activeloom-review.json",
        ".gitignore",
        ".prettierignore",
        ".prettierrc",
        "recommended-prettierignore.txt",
        "pyproject.toml",
        ".claude/*.py",
        ".claude/*.allowlist",
        ".claude/*.json",
        ".claude/*.template",
        ".claude/references/**",
        "scripts/install-skills.sh",
        "scripts/check-action-pin-drift.sh",
        "scripts/review-telemetry.json.template",
        "claude/**",
        "tests/__init__.py",
        "tests/conftest.py",
        "scripts/run-tests.py",
        "scripts/select-focused-tests.py",
        "scripts/require-regression-green.sh",
        "tests/test_test_lanes.py"
      ],
      "commands": [
        {
          "argv": [
            "python3",
            ".codex/skills/critique/scripts/review-chain-runner.py",
            "--validate-contract"
          ]
        }
      ]
    }
  }
}
