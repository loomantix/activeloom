{
  "schema_version": 1,
  "fallback_gate": "full",
  "gates": {
    "baseline": {
      "always": true,
      "commands": [
        { "argv": ["python3", "-m", "mypy"] },
        { "argv": ["ruff", "check", "."] },
        { "argv": ["npx", "--yes", "prettier@3.8.3", "--check", "."] },
