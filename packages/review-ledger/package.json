{
  "name": "@loomantix/review-ledger",
  "version": "1.5.0",
  "type": "module",
  "description": "Deterministic local-review ledger protocol, verification, and CLI for multi-engine code review relays.",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomantix/platform-oss.git",
    "directory": "packages/review-ledger"
  },
  "license": "Apache-2.0",
  "bin": {
    "review-ledger": "./dist/bin.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "protocol",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "bin": {
      "review-ledger": "./dist/bin.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "7.29.3"
  }
}
