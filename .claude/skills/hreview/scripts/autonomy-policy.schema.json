{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected autonomy policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["autonomy", "network"],
  "properties": {
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["full", "manual"] },
        "stops": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "enum": [
              "restart",
              "restart-after-exhausted",
              "scope-decision",
              "author"
            ]
          }
        },
        "restart_budget": { "type": "integer", "minimum": 0, "default": 2 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["restricted", "open"] },
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
          }
        }
      }
    }
  }
}
