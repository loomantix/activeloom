# Consumer-owned agent-loop settings. Literal `key = value` lines; this file is
# parsed, never sourced. Bootstrapped from this template on first sync
# (create_if_missing); later upstream edits do not overwrite it. Do not embed
# credentials, identifiers, PHI, or user data — hook output is not sanitized.

# Integration branch. Leave empty to use origin/HEAD, then main. Set it when
# your integration branch differs from the default branch (e.g. a staging->main
# promotion flow). Env AGENT_LOOP_BASE_BRANCH overrides this for a one-off run.
base_branch =

# Run once inside each new issue worktree. Use an isolated frozen install; never
# symlink mutable node_modules or equivalent dependency directories.
setup_hook =

# Run after the worker, after each local review, and after fresh-base merge.
# Prefer targeted checks and avoid unbounded full-suite output.
validation_hook =

# Version 3 hooks run only after the wrapper opens a draft PR. Each must read
# the complete PR ledger, post confirmed findings inline before editing, commit
# and publish fixes through $AGENT_LOOP_REVIEW_PUSH_HELPER, reply with the fix SHA and
# validation, resolve completed threads, and leave local/remote/PR heads equal.
# Every successfully completed clean or changed pass calls `review-ledger.js
# write-result`, which derives the complete same-round disposition set and
# atomically writes $AGENT_LOOP_REVIEW_RESULT_FILE. A blocked hook uses
# `review-ledger.js write-blocked-result` with an owner-only blocker file and
# must not claim a clean or changed pass.
# Review hooks never post pass/completion markers because
# the wrapper validates the result and owns those attestations.
# Findings, replies, and attestations must be posted by the authenticated
# GitHub actor running this wrapper; evidence from other accounts is ignored.
# Validation hooks must also leave a clean tree.
# They must not force-push, merge, or invoke hosted AI reviewers.
# Codex runs `deepcritique`; Claude runs `deepcritique` with the consumer's literal
# effort policy (for example `claude --effort low /deepcritique ...`).
review_contract_version = 3
config_doctor = true
claude_effort_policy =
review_max_rounds = 4
# Positive wall-clock budget for one selected issue's review. The deadline is
# persisted so resume cannot reset it; each review pass and its validation is
# bounded by the smaller of the remaining budget and hook_timeout_seconds, and
# a run whose remaining budget is too small to finish a pass stops rather than
# starting one it cannot complete.
review_timeout_seconds = 7200
#
# MODEL SELECTION. A review hook is a literal shell command, so the engine's
# model and effort are chosen here rather than through dedicated config keys —
# whatever flags your CLI accepts. For example:
#
#   claude_review_hook = claude --print --effort low --model <model-id> "/deepcritique ..."
#   codex_review_hook  = codex exec -c model_reasoning_effort=medium "...deepcritique..."
#
# Pick per aspect, not globally: measured on real issues, the two review passes
# are 75-84% of a run's wall clock and the worker is 10-17%, so reviewer choice
# dominates cost while worker choice dominates how many rounds are needed.
#
# LIMITATION: both hooks are currently required and the engine roster is fixed
# at exactly Codex then Claude. There is no key for a third engine and no way to
# omit one, so today the loop cannot run without both CLIs available.
claude_review_hook =
codex_review_hook =

# Optional worker override. When empty, the wrapper runs the Claude CLI in
# headless, auto-approving mode (--permission-mode bypassPermissions --print)
# with the prompt from prompt.txt, honoring the model settings below. Set this
# to run a different implementation agent instead.
worker_hook =
# Model ids as your CLI accepts them. `worker_model` is the primary and
# `worker_fallback_model` is used only after a clean capacity/timeout failure
# that left the worktree unchanged, so set them together: pinning a strong
# primary without a fallback makes capacity errors more expensive. Leaving both
# empty is NOT neutral — the worker then runs on whatever your CLI currently
# defaults to, which changes with CLI releases, so the one slot that determines
# how much work the reviewers have to do is the one slot that is not pinned.
#
# The worker invocation supports a model and nothing else; there is no effort
# control for the worker. Reviewer model and effort are chosen inside the review
# hook commands below.
worker_model =
worker_fallback_model =
worker_retries = 1
worker_timeout_seconds = 3600
hook_timeout_seconds = 3600
retry_on_timeout = true
retry_delay_seconds = 15

# `ready` preserves legacy open/closed dependency behavior. `merged-to-base`
# requires dependency PR merge commits to be present in origin/<base>.
dependency_gate = ready

branch_prefix = agent-loop
worktree_root = /tmp/agent-loop-worktrees
log_root = /tmp/agent-loop-logs
log_max_kb = 1024
output_max_lines = 40
