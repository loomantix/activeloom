# Consumer-owned agent-loop settings. Literal `key = value` lines; this file is
# parsed, never sourced. Bootstrapped from this template on first sync
# (create_if_missing); later upstream edits do not overwrite it. Do not embed
# credentials, identifiers, PHI, or user data — hook output is not sanitized.

# Integration branch. Leave empty to use origin/HEAD, then main. Set it when
# your integration branch differs from the default branch (e.g. a staging->main
# promotion flow). Env AGENT_LOOP_BASE_BRANCH overrides this for a one-off run.
base_branch =

# Run once inside each new issue worktree. Use an isolated frozen install; never
# symlink mutable node_modules or equivalent dependency directories.
setup_hook =

# Run after the worker, after each local review, and after fresh-base merge.
# This is the gating run: use the repository's declared review gate, bounded
# and with concise output, not a narrower targeted check.
validation_hook =

# Version 3 hooks run only after the wrapper opens a draft PR. Each must read
# the complete PR ledger, post confirmed findings inline before editing, commit
# and publish fixes through $AGENT_LOOP_REVIEW_PUSH_HELPER, reply with the fix SHA and
# validation, resolve completed threads, and leave local/remote/PR heads equal.
# Every successfully completed clean or changed pass calls `review-ledger.js
# write-result`, which derives the complete same-round disposition set and
# atomically writes $AGENT_LOOP_REVIEW_RESULT_FILE. A blocked hook uses
# `review-ledger.js write-blocked-result` with an owner-only blocker file and
# must not claim a clean or changed pass.
# Review hooks never post pass/completion markers because
# the wrapper validates the result and owns those attestations.
# Findings, replies, and attestations must be posted by the authenticated
# GitHub actor running this wrapper; evidence from other accounts is ignored.
# Validation hooks must also leave a clean tree.
# They must not force-push, merge, or invoke hosted AI reviewers.
# Codex runs `deepcritique`; Claude runs `deepcritique` with the consumer's literal
# effort policy (for example `claude --effort low /deepcritique ...`).
# Ask review hooks for focused checks on their own fixes only. validation_hook
# is the gating suite: the wrapper runs it on the exact head after every pass,
# so a hook that also runs the full suite duplicates it and can end its turn
# while that suite is still running.
review_contract_version = 3
config_doctor = true
claude_effort_policy =
review_max_rounds = 4
# Positive wall-clock budget for one selected issue's review. The deadline is
# persisted so resume cannot reset it; each review pass and its validation is
# bounded by the smaller of the remaining budget and hook_timeout_seconds, and
# a run whose remaining budget is too small to finish a pass stops rather than
# starting one it cannot complete.
review_timeout_seconds = 7200
#
# MODEL SELECTION. A review hook is a literal shell command, so the engine's
# model and effort are chosen here rather than through dedicated config keys —
# whatever flags your CLI accepts. These fragments show flag placement only; a
# working hook must also carry AGENT_LOOP_REVIEW_PUSH_HELPER,
# AGENT_LOOP_REVIEW_RESULT_FILE, and write-result, or preflight rejects it.
#
#   claude_review_hook = claude --print --effort low --model <model-id> /deepcritique ... </dev/null
#   codex_review_hook  = codex exec -c model_reasoning_effort=medium ... /deepcritique ... </dev/null
#
# The wrapper runs every hook and the default worker with stdin from /dev/null
# (`codex exec` reads stdin to EOF when it is not a TTY and would otherwise
# block for the whole pass on an inherited pipe); the trailing redirect keeps a
# hook safe when it is pasted and run outside the wrapper. It also exports
# CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1 for every hook, so a Claude CLI cannot
# end its turn while a command it backgrounded is still running; do not
# override it in a hook.
#
# Pick per aspect, not globally: the two review passes dominate a run's wall
# clock and the worker is a small fraction of it, so reviewer choice dominates
# cost while worker choice dominates how many rounds are needed. See "Model
# Selection" in SKILL.md for the measured shares.
#
# LIMITATION: both hooks are required and the engine roster is fixed at exactly
# Codex then Claude. There is no key for a third engine and no way to omit one,
# so a run without both CLIs fails at the first review pass — after the issue is
# claimed and the draft PR is open, not at startup.
claude_review_hook =
codex_review_hook =

# Optional worker override. When empty, the wrapper runs the Claude CLI in
# headless, auto-approving mode (--permission-mode bypassPermissions --print)
# with the prompt from prompt.txt, honoring the model settings below. Set this
# to run a different implementation agent instead.
worker_hook =
# Both keys apply to the DEFAULT worker only, and are ignored entirely when
# worker_hook is set above — a hook pins its own model, in the hook.
#
# Model ids as your CLI accepts them. `worker_model` is the primary and
# `worker_fallback_model` is used only after a clean capacity failure that left
# the worktree unchanged; a timeout retries on the primary model. Set them
# together anyway: pinning a strong primary without a fallback makes capacity
# errors more expensive. Leaving both empty is NOT neutral — the worker then
# runs on whatever your CLI currently defaults to, which changes with CLI
# releases, so the one slot that determines how much work the reviewers have to
# do is the one slot that is not pinned.
#
# `worker_effort` is passed to the default worker as `--effort`. Leave it empty
# and the worker runs at whatever the CLI or the launching environment defaults
# to, which is easy to forget and invisible afterwards — the doctor warns.
# When `claude_effort_policy` is set the doctor requires the two to match, since
# the default worker is the same CLI the policy governs. Reviewer model and
# effort are chosen inside the review hook commands above.
worker_model =
worker_fallback_model =
worker_effort =
worker_retries = 1
worker_timeout_seconds = 3600
hook_timeout_seconds = 3600
retry_on_timeout = true
retry_delay_seconds = 15

# `ready` preserves legacy open/closed dependency behavior. `merged-to-base`
# requires dependency PR merge commits to be present in origin/<base>.
# `batch-stack` applies `merged-to-base`, except that an issue declaring
# `Depends on #N` on an earlier, finalized, unmerged entry of the same ordered
# batch is built on that entry's branch and opens its PR against it.
dependency_gate = ready

# What an ordered batch (`--issues N,N,...`) does when one issue fails. `stop`
# halts the batch there. `park` records a failure the wrapper can verify is
# safely resumable (clean worktree, local/remote/PR heads that agree with its
# checkpoint, a resumable stop category) as parked, continues with the next
# issue, parks issues that depend on a parked one without starting them, and
# exits 3 listing the resume commands.
batch_on_issue_failure = stop

branch_prefix = agent-loop
worktree_root = /tmp/agent-loop-worktrees
log_root = /tmp/agent-loop-logs
log_max_kb = 1024
output_max_lines = 40
